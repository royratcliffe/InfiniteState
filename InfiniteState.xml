              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">StampAtDepth := EMPTY_STAMP;

IF depth = ERROR_DEPTH THEN
	RETURN;
END_IF

IF LOWER_BOUND(stamps, 1) &gt; depth OR depth &gt; UPPER_BOUND(stamps, 1) THEN
	RETURN;
END_IF

StampAtDepth := stamps[depth];
</xhtml>
                </ST>
