                </array>
              </type>
            </variable>
          </localVars>
          <outputVars>
            <variable name="Depth">
              <type>
                <derived name="DEPTH" />
              </type>
            </variable>
            <variable name="States">
              <type>
                <array>
                  <dimension lower="LOWER_DEPTH" upper="UPPER_DEPTH" />
                  <baseType>
                    <derived name="STATE" />
                  </baseType>
                </array>
              </type>
            </variable>
            <variable name="EntryDepth">
              <type>
                <derived name="DEPTH" />
              </type>
            </variable>
            <variable name="EntryStates">
              <type>
                <array>
                  <dimension lower="LOWER_DEPTH" upper="UPPER_DEPTH" />
                  <baseType>
                    <derived name="STATE" />
                  </baseType>
                </array>
              </type>
            </variable>
            <variable name="ExitDepth">
              <type>
                <derived name="DEPTH" />
              </type>
            </variable>
            <variable name="ExitStates">
              <type>
                <array>
                  <dimension lower="LOWER_DEPTH" upper="UPPER_DEPTH" />
                  <baseType>
                    <derived name="STATE" />
                  </baseType>
                </array>
              </type>
            </variable>
          </outputVars>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml"> =============================================================================
Function Block : Machine

Purpose:
    Tracks a hierarchical machine's active state path and records the time each
    active state was entered.

Application:
    Use one instance per machine. Supply the state hierarchy when requesting a
    transition, then inspect the active, entered, and exited states and state
    timestamps through the instance.

Operation:
    1. Call GoTo with a target state and its hierarchy of (superState, subState)
       pairs.
    2. GoTo finds the common ancestor, removes states no longer active, and
       adds the target's remaining ancestors and state to the active path.
    3. Entered states receive a high-resolution RTC timestamp. The EntryStates
       and ExitStates outputs report the states added to and removed from the
       path by the most recent transition.

Inputs:
    GoTo.state      - Target state to activate.
    GoTo.hierarchy  - Array of Tuple values describing super-state/sub-state
                      relationships; EMPTY_STATE terminates the target path.

Outputs:
    Depth       - Number of active states in the path.
    States      - Active state path, ordered from outermost to innermost.
    EntryDepth  - Number of states entered by the most recent GoTo.
    EntryStates - States entered, ordered from outermost to innermost.
    ExitDepth   - Number of states exited by the most recent GoTo.
    ExitStates  - States exited, ordered from innermost to outermost.

InOut:
    GoTo.hierarchy  - Caller-provided hierarchy array, passed as constant
                      in-out data to the GoTo method.

Alarms/Faults:
    No alarm outputs. GoTo returns FALSE when it cannot build or complete a
    transition. Timestamp methods return EMPTY_STAMP if a timestamp is
    unavailable or the RTC call fails.

Assumptions:
    - State identifiers are nonzero; EMPTY_STATE (0) denotes no state and ends
      the ancestry walk.
    - Update GVL.now from the system high-resolution RTC before calling GoTo
      or ElapsedInState; otherwise state timestamps and elapsed times use a
      stale value.
    - The hierarchy contains the parent relationship needed to reach the
      requested target.

Limitations:
    - The active path and transition lists have fixed bounds LOWER_DEPTH..UPPER_DEPTH
      (currently 0..7), for a maximum of eight states.
    - GoTo processes a transition incrementally; if it returns FALSE after
      processing has begun, inspect the outputs before issuing another
      transition.

Dependencies:
    - Chain, Tuple, STATE, DEPTH, and STAMP declarations and the state-chain
      helper functions.
    - SysTimeRtc and CmpErrors libraries for high-resolution timestamps.

Example:

    xTransitioned := fbMachine.GoTo(
        state := targetState,
        hierarchy := stateHierarchy
    );

Revision History:
    See source control history.
============================================================================= </xhtml>
          </documentation>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">Depth       := chain.depth;
States      := chain.states;
EntryDepth  := entryChain.depth;
EntryStates := entryChain.states;
ExitDepth   := exitChain.depth;
ExitStates  := exitChain.states;
</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="AtDepth" ObjectId="ca5ed2e6-ca50-49d8-88cd-0dab8cedbea2">
              <interface>
                <returnType>
                  <derived name="STATE" />
                </returnType>
                <inputVars>
                  <variable name="depth">
                    <type>
                      <derived name="DEPTH" />
                    </type>
                  </variable>
                </inputVars>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">AtDepth := EMPTY_STATE;

IF LOWER_BOUND(chain.states, 1) &gt; depth OR depth &gt; UPPER_BOUND(chain.states, 1) THEN
	RETURN;
END_IF

IF depth &gt; chain.depth THEN
	RETURN;
END_IF

AtDepth := chain.states[depth];
</xhtml>
                </ST>
              </body>
              <addData />
            </Method>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="ElapsedInState" ObjectId="e6cab5f2-08eb-4bdc-af17-51b3f85a541b">
              <interface>
                <returnType>
                  <derived name="STAMP" />
                </returnType>
                <inputVars>
                  <variable name="state">
                    <type>
                      <derived name="STATE" />
                    </type>
                  </variable>
                </inputVars>
                <localVars>
                  <variable name="stamp">
                    <type>
                      <derived name="STAMP" />
                    </type>
                  </variable>
                </localVars>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">ElapsedInState := EMPTY_STAMP;
stamp          := StampInState(state);

IF stamp = EMPTY_STAMP THEN
	RETURN;
END_IF

ElapsedInState := now - stamp;
</xhtml>
                </ST>
              </body>
              <addData />
            </Method>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="EnterState" ObjectId="b8eda0f2-6e0f-428e-9915-38edfba9b625">
              <interface>
                <returnType>
                  <BOOL />
                </returnType>
                <inputVars>
                  <variable name="depth">
                    <type>
                      <derived name="DEPTH" />
                    </type>
                  </variable>
                </inputVars>
                <addData>
                  <data name="http://www.3s-software.com/plcopenxml/accessmodifiers" handleUnknown="implementation">
                    <AccessModifiers Protected="true" />
                  </data>
                </addData>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">EnterState := FALSE;

IF LOWER_BOUND(stamps, 1) &gt; depth OR depth &gt; UPPER_BOUND(stamps, 1) THEN
	RETURN;
END_IF

stamps[depth] := now;
EnterState    := TRUE;
</xhtml>
                </ST>
              </body>
              <addData />
            </Method>
