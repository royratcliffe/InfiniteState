    <pous>
      <pou name="Machine" pouType="functionBlock">
        <interface>
          <localVars>
            <variable name="chain">
              <type>
                <derived name="Chain" />
              </type>
            </variable>
            <variable name="stamps">
              <type>
                <array>
                  <dimension lower="LOWER_DEPTH" upper="UPPER_DEPTH" />
                  <baseType>
                    <derived name="STAMP" />
                  </baseType>
                </array>
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml" />
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="AtDepth" ObjectId="ca5ed2e6-ca50-49d8-88cd-0dab8cedbea2">
              <interface>
                <returnType>
                  <derived name="STATE" />
                </returnType>
                <inputVars>
                  <variable name="depth">
                    <type>
                      <derived name="DEPTH" />
                    </type>
                  </variable>
                </inputVars>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">AtDepth := EMPTY_STATE;

IF LOWER_BOUND(chain.states, 1) &gt; depth OR depth &gt; UPPER_BOUND(chain.states, 1) THEN
	RETURN;
END_IF

IF depth &gt; chain.depth THEN
	RETURN;
END_IF

AtDepth := chain.states[depth];
</xhtml>
                </ST>
              </body>
              <addData />
            </Method>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="ElapsedInState" ObjectId="e6cab5f2-08eb-4bdc-af17-51b3f85a541b">
              <interface>
                <returnType>
                  <derived name="SysTimeRtc.SYSTIME" />
                </returnType>
                <inputVars>
                  <variable name="state">
                    <type>
                      <derived name="STATE" />
                    </type>
                  </variable>
                </inputVars>
                <localVars>
                  <variable name="now">
                    <type>
                      <derived name="STAMP" />
                    </type>
                  </variable>
                  <variable name="stamp">
                    <type>
                      <derived name="STAMP" />
                    </type>
                  </variable>
                </localVars>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">ElapsedInState := EMPTY_STAMP;

IF SysTimeRtcHighResGet(now) &lt;&gt; CmpErrors.Errors.ERR_OK THEN
	RETURN;
END_IF

stamp := StampInState(state);

IF stamp = EMPTY_STAMP THEN
	RETURN;
END_IF

ElapsedInState := now - stamp;
</xhtml>
                </ST>
              </body>
              <addData />
            </Method>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="EnterState" ObjectId="b8eda0f2-6e0f-428e-9915-38edfba9b625">
              <interface>
                <returnType>
                  <BOOL />
                </returnType>
                <inputVars>
                  <variable name="depth">
                    <type>
                      <derived name="DEPTH" />
                    </type>
                  </variable>
                </inputVars>
                <addData>
                  <data name="http://www.3s-software.com/plcopenxml/accessmodifiers" handleUnknown="implementation">
                    <AccessModifiers Protected="true" />
                  </data>
                </addData>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">EnterState := FALSE;

IF LOWER_BOUND(stamps, 1) &gt; depth OR depth &gt; UPPER_BOUND(stamps, 1) THEN
	RETURN;
END_IF

IF SysTimeRtcHighResGet(stamps[depth]) &lt;&gt; CmpErrors.Errors.ERR_OK THEN
	RETURN;
END_IF

EnterState := TRUE;
</xhtml>
                </ST>
              </body>
              <addData />
            </Method>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="ExitState" ObjectId="dd4a2c26-8cb1-4edd-8adf-6448d3195485">
              <interface>
                <returnType>
                  <BOOL />
                </returnType>
                <inputVars>
                  <variable name="depth">
                    <type>
                      <derived name="DEPTH" />
                    </type>
                  </variable>
                </inputVars>
                <addData>
                  <data name="http://www.3s-software.com/plcopenxml/accessmodifiers" handleUnknown="implementation">
                    <AccessModifiers Protected="true" />
                  </data>
                </addData>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">ExitState := FALSE;

IF LOWER_BOUND(stamps, 1) &gt; depth OR depth &gt; UPPER_BOUND(stamps, 1) THEN
	RETURN;
END_IF

stamps[depth] := EMPTY_STAMP;
ExitState     := TRUE;
</xhtml>
                </ST>
              </body>
              <addData />
            </Method>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="GoTo" ObjectId="1fa6baac-d579-4ce9-bce2-ce4412c84898">
              <interface>
                <returnType>
                  <BOOL />
                </returnType>
                <inputVars>
                  <variable name="state">
                    <type>
                      <derived name="STATE" />
                    </type>
                  </variable>
                </inputVars>
                <inputVars constant="true">
                  <variable name="hierarchy">
                    <type>
                      <pointer>
                        <baseType>
                          <derived name="Tuple" />
                        </baseType>
                      </pointer>
                    </type>
                    <addData>
                      <data name="http://www.3s-software.com/plcopenxml/attributes" handleUnknown="implementation">
                        <Attributes>
                          <Attribute Name="variable_length_array_original_scope" Value="Inout" />
                          <Attribute Name="variable_length_array" Value="ARRAY[*] OF Tuple" />
                          <Attribute Name="Dimensions" Value="1" />
                        </Attributes>
                      </data>
                    </addData>
                  </variable>
                </inputVars>
                <localVars>
                  <variable name="chain">
                    <type>
                      <derived name="Chain" />
                    </type>
                  </variable>
                  <variable name="depth">
                    <type>
                      <derived name="DEPTH" />
                    </type>
                  </variable>
                  <variable name="sub_state">
                    <type>
                      <derived name="STATE" />
                    </type>
                  </variable>
                </localVars>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">GoTo := FALSE;

IF NOT chain_of_state(state, hierarchy, chain) THEN
	RETURN;
END_IF

depth := lca(THIS^.chain, chain);

{analysis -41}
WHILE THIS^.chain.depth &gt; depth DO
	IF NOT ExitState(THIS^.chain.depth - 1) THEN
		RETURN;
	END_IF

	IF NOT pop_state_from_chain(sub_state, THIS^.chain) THEN
		RETURN;
	END_IF
END_WHILE

WHILE THIS^.chain.depth &lt; chain.depth DO
	IF NOT push_state_to_chain(state_at_depth(THIS^.chain.depth, chain), THIS^.chain) THEN
		RETURN;
	END_IF

	IF NOT EnterState(THIS^.chain.depth - 1) THEN
		RETURN;
	END_IF
END_WHILE

{analysis +41}
GoTo := TRUE;
</xhtml>
                </ST>
              </body>
              <addData />
            </Method>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="InState" ObjectId="f14b1f36-cb51-4638-8045-4d20e388402b">
              <interface>
                <returnType>
                  <BOOL />
                </returnType>
                <inputVars>
                  <variable name="state">
                    <type>
                      <derived name="STATE" />
                    </type>
                  </variable>
                </inputVars>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">InState := depth_in_chain(state, chain) &lt;&gt; ERROR_DEPTH;
</xhtml>
                </ST>
              </body>
