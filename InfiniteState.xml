          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="GoTo" ObjectId="1fa6baac-d579-4ce9-bce2-ce4412c84898">
              <interface>
                <returnType>
                  <BOOL />
                </returnType>
                <inputVars>
                  <variable name="state">
                    <type>
                      <derived name="STATE" />
                    </type>
                  </variable>
                </inputVars>
                <inputVars constant="true">
                  <variable name="hierarchy">
                    <type>
                      <pointer>
                        <baseType>
                          <derived name="Tuple" />
                        </baseType>
                      </pointer>
                    </type>
                    <addData>
                      <data name="http://www.3s-software.com/plcopenxml/attributes" handleUnknown="implementation">
                        <Attributes>
                          <Attribute Name="variable_length_array_original_scope" Value="Inout" />
                          <Attribute Name="variable_length_array" Value="ARRAY[*] OF Tuple" />
                          <Attribute Name="Dimensions" Value="1" />
                        </Attributes>
                      </data>
                    </addData>
                  </variable>
                </inputVars>
                <localVars>
                  <variable name="chain">
                    <type>
                      <derived name="Chain" />
                    </type>
                  </variable>
                  <variable name="depth">
                    <type>
                      <derived name="DEPTH" />
                    </type>
                  </variable>
                  <variable name="sub_state">
                    <type>
                      <derived name="STATE" />
                    </type>
                  </variable>
                </localVars>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">GoTo := FALSE;

(* Build the chain of states leading to the target jump state based on the given hierarchy. *)
IF NOT chain_of_state(state, hierarchy, chain) THEN
	RETURN;
END_IF

(* Determine the depth of the least-common ancestor between the current chain and the jump chain. *)
depth := lca(THIS^.chain, chain);

(* Empty the exit chain before proceeding. This always succeeds in
   clearing any previously stored exit states. *)
IF NOT empty_chain(exitChain) THEN
	RETURN;
END_IF

{analysis -41}
WHILE THIS^.chain.depth &gt; depth DO
	IF NOT ExitState(THIS^.chain.depth - 1) THEN
		RETURN;
	END_IF

	IF NOT pop_state_from_chain(sub_state, THIS^.chain) THEN
		RETURN;
	END_IF

	IF NOT push_state_to_chain(sub_state, exitChain) THEN
		RETURN;
	END_IF
END_WHILE

IF NOT empty_chain(entryChain) THEN
	RETURN;
END_IF

WHILE THIS^.chain.depth &lt; chain.depth DO
	sub_state := state_at_depth(THIS^.chain.depth, chain);

	IF NOT push_state_to_chain(sub_state, THIS^.chain) THEN
		RETURN;
	END_IF

	IF NOT push_state_to_chain(sub_state, entryChain) THEN
		RETURN;
	END_IF

	IF NOT EnterState(THIS^.chain.depth - 1) THEN
		RETURN;
	END_IF
END_WHILE

{analysis +41}
GoTo := TRUE;
</xhtml>
                </ST>
              </body>
              <addData />
            </Method>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
