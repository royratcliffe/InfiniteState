      </pou>
      <pou name="chain_of_state" pouType="function">
        <interface>
          <returnType>
            <BOOL />
          </returnType>
          <inputVars>
            <variable name="state">
              <type>
                <derived name="STATE" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Jump state for which to build the chain of states. </xhtml>
              </documentation>
            </variable>
          </inputVars>
          <inputVars constant="true">
            <variable name="hierarchy">
              <type>
                <pointer>
                  <baseType>
                    <derived name="Tuple" />
                  </baseType>
                </pointer>
              </type>
              <addData>
                <data name="http://www.3s-software.com/plcopenxml/attributes" handleUnknown="implementation">
                  <Attributes>
                    <Attribute Name="variable_length_array_original_scope" Value="Inout" />
                    <Attribute Name="variable_length_array" Value="ARRAY[*] OF Tuple" />
                    <Attribute Name="Dimensions" Value="1" />
                  </Attributes>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Hierarchy of states used to build the chain. </xhtml>
              </documentation>
            </variable>
          </inputVars>
          <inOutVars>
            <variable name="chain">
              <type>
                <derived name="Chain" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Chain of states being built for the jump state. </xhtml>
              </documentation>
            </variable>
          </inOutVars>
          <localVars>
            <variable name="super_chain">
              <type>
                <derived name="Chain" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Temporary chain used to build the reverse chain of states leading to the jump state. </xhtml>
              </documentation>
            </variable>
            <variable name="super_state">
              <type>
                <derived name="STATE" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Temporary variable to hold the current state being processed in the reverse chain. </xhtml>
              </documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">chain_of_state := FALSE;
super_state    := state;

WHILE super_state &lt;&gt; EMPTY_STATE DO
	IF NOT push_state_to_chain(super_state, super_chain) THEN
		RETURN;
	END_IF

	super_state := super_state_of(super_state, hierarchy);
END_WHILE

(* Pop all states from the original chain. This empties the original
   chain before transferring states from the reverse chain. As a
   by-product, the original chain will be empty and cleared before
   states are transferred from the reverse chain. *)
IF NOT empty_chain(chain) THEN
	RETURN;
END_IF

(* Transfer states from the reverse chain back to the original chain.
   This will never fail in practice. The reverse chain fits, so the
   transfer back to the original chain will always succeed. The push
   check exists for completeness. *)
WHILE pop_state_from_chain(super_state, super_chain) DO
	IF NOT push_state_to_chain(super_state, chain) THEN
		RETURN;
	END_IF
END_WHILE

chain_of_state := TRUE;
</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>138c894b-4a03-4afd-bbc2-6da659dfdbcd</ObjectId>
          </data>
        </addData>
      </pou>
      <pou name="depth_in_chain" pouType="function">
        <interface>
          <returnType>
            <derived name="DEPTH" />
          </returnType>
          <inputVars>
            <variable name="state">
              <type>
                <derived name="STATE" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> The state whose depth in the chain is to be found </xhtml>
              </documentation>
            </variable>
          </inputVars>
          <inOutVars constant="true">
            <variable name="chain">
              <type>
                <derived name="Chain" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> The chain in which to find the depth of the given state </xhtml>
              </documentation>
            </variable>
          </inOutVars>
          <localVars>
            <variable name="depth">
              <type>
                <derived name="DEPTH" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> The current depth being checked in the chain </xhtml>
              </documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">depth_in_chain := ERROR_DEPTH;

FOR depth := LOWER_BOUND(chain.states, 1) TO UPPER_BOUND(chain.states, 1) DO
	(* The FOR loop iterates through the states in the chain,
	   inclusively from the lower bound to the upper bound, to find the
	   depth of the given state. Fail when the scan depth matches or
	   exceeds the chain depth. In practice, it will never exceed the
	   chain depth. *)
	IF depth &gt;= chain.depth THEN
		EXIT;
	END_IF

	IF chain.states[depth] = state THEN
		depth_in_chain := depth;
		EXIT;
	END_IF
END_FOR
</xhtml>
          </ST>
        </body>
