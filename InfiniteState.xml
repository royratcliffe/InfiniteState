          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="StampInState" ObjectId="f97e0f66-6e62-45f8-88d5-3a76f53cf44e">
              <interface>
                <returnType>
                  <derived name="STAMP" />
                </returnType>
                <inputVars>
                  <variable name="state">
