      <pou name="chain_of_state" pouType="function">
        <interface>
          <returnType>
            <BOOL />
          </returnType>
          <inputVars>
            <variable name="state">
              <type>
                <derived name="STATE" />
              </type>
            </variable>
          </inputVars>
          <inputVars constant="true">
            <variable name="hierarchy">
              <type>
                <pointer>
                  <baseType>
                    <derived name="Tuple" />
                  </baseType>
                </pointer>
              </type>
              <addData>
                <data name="http://www.3s-software.com/plcopenxml/attributes" handleUnknown="implementation">
                  <Attributes>
                    <Attribute Name="variable_length_array_original_scope" Value="Inout" />
                    <Attribute Name="variable_length_array" Value="ARRAY[*] OF Tuple" />
                    <Attribute Name="Dimensions" Value="1" />
                  </Attributes>
                </data>
              </addData>
            </variable>
          </inputVars>
          <inOutVars>
            <variable name="chain">
              <type>
                <derived name="Chain" />
              </type>
            </variable>
          </inOutVars>
          <localVars>
            <variable name="super_chain">
              <type>
                <derived name="Chain" />
              </type>
            </variable>
            <variable name="super_state">
              <type>
                <derived name="STATE" />
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">chain_of_state := FALSE;
super_state    := state;

WHILE super_state &lt;&gt; EMPTY_STATE DO
	IF NOT push_state_to_chain(super_state, super_chain) THEN
		RETURN;
	END_IF

	super_state := super_state_of(super_state, hierarchy);
END_WHILE

(* Pop all states from the original chain. This empties the original
   chain before transferring states from the reverse chain. As a
   by-product, the original chain will be empty and cleared before
   states are transferred from the reverse chain. *)
WHILE pop_state_from_chain(super_state, chain) DO
	;
END_WHILE;

(* Transfer states from the reverse chain back to the original chain.
   This will never fail in practice. The reverse chain fits, so the
   transfer back to the original chain will always succeed. The push
   check exists for completeness. *)
WHILE pop_state_from_chain(super_state, super_chain) DO
	IF NOT push_state_to_chain(super_state, chain) THEN
		RETURN;
	END_IF
END_WHILE

chain_of_state := TRUE;
</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>138c894b-4a03-4afd-bbc2-6da659dfdbcd</ObjectId>
          </data>
        </addData>
      </pou>
      <pou name="depth_in_chain" pouType="function">
        <interface>
          <returnType>
            <derived name="DEPTH" />
          </returnType>
          <inputVars>
            <variable name="state">
              <type>
                <derived name="STATE" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> The state whose depth in the chain is to be found </xhtml>
              </documentation>
            </variable>
          </inputVars>
          <inOutVars constant="true">
            <variable name="chain">
              <type>
                <derived name="Chain" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> The chain in which to find the depth of the given state </xhtml>
              </documentation>
            </variable>
          </inOutVars>
          <localVars>
            <variable name="depth">
              <type>
                <derived name="DEPTH" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> The current depth being checked in the chain </xhtml>
              </documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">depth_in_chain := ERROR_DEPTH;

FOR depth := LOWER_BOUND(chain.states, 1) TO UPPER_BOUND(chain.states, 1) DO
	(* The FOR loop iterates through the states in the chain,
	   inclusively from the lower bound to the upper bound, to find the
	   depth of the given state. Fail when the scan depth matches or
	   exceeds the chain depth. In practice, it will never exceed the
	   chain depth. *)
	IF depth &gt;= chain.depth THEN
		EXIT;
	END_IF

	IF chain.states[depth] = state THEN
		depth_in_chain := depth;
		EXIT;
	END_IF
END_FOR
</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>474f5380-84df-40c8-a9f1-a755a27c5461</ObjectId>
          </data>
        </addData>
      </pou>
      <pou name="lca" pouType="function">
        <interface>
          <returnType>
            <derived name="DEPTH" />
          </returnType>
          <inOutVars constant="true">
            <variable name="outgoing">
              <type>
                <derived name="Chain" />
              </type>
            </variable>
            <variable name="incoming">
              <type>
                <derived name="Chain" />
              </type>
            </variable>
          </inOutVars>
          <localVars>
            <variable name="depth">
              <type>
                <derived name="DEPTH" />
              </type>
              <initialValue>
                <simpleValue value="LOWER_DEPTH" />
              </initialValue>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">WHILE depth &lt; incoming.depth DO
	IF depth = outgoing.depth THEN
		EXIT;
	END_IF

	IF LOWER_BOUND(outgoing.states, 1) &gt; depth OR depth &gt; UPPER_BOUND(outgoing.states, 1) THEN
		EXIT;
	END_IF

	IF outgoing.states[depth] &lt;&gt; incoming.states[depth] THEN
		EXIT;
	END_IF

	depth := depth + 1;
END_WHILE

lca := depth;
</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>5d10cb61-2f6e-4461-bfd9-39cd59cdf83a</ObjectId>
          </data>
        </addData>
      </pou>
      <pou name="pop_state_from_chain" pouType="function">
        <interface>
          <returnType>
            <BOOL />
          </returnType>
          <inOutVars>
            <variable name="state">
              <type>
                <derived name="STATE" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> The state popped from the chain, if successful </xhtml>
              </documentation>
            </variable>
            <variable name="chain">
              <type>
                <derived name="Chain" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> The chain from which to pop the state </xhtml>
              </documentation>
            </variable>
          </inOutVars>
          <localVars>
            <variable name="depth">
              <type>
                <derived name="DEPTH" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> The depth of the chain after pre-decrementing </xhtml>
              </documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">pop_state_from_chain := FALSE;
depth                := chain.depth - 1; (* pre-decrement the depth of the chain *)

(* Answer FALSE if the pre-decremented depth is out of bounds, TRUE
   otherwise. Zero out the popped state in the chain. Not strictly
   necessary, but helps prevent stale states. *)
IF LOWER_BOUND(chain.states, 1) &gt; depth OR depth &gt; UPPER_BOUND(chain.states, 1) THEN
	RETURN;
END_IF

chain.depth          := depth;
state                := chain.states[depth];
chain.states[depth]  := EMPTY_STATE;
pop_state_from_chain := TRUE;
</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>043dfc31-074e-484d-ab50-fa230e42691d</ObjectId>
          </data>
        </addData>
      </pou>
      <pou name="push_state_to_chain" pouType="function">
        <interface>
          <returnType>
            <BOOL />
          </returnType>
          <inputVars>
            <variable name="state">
              <type>
                <derived name="STATE" />
              </type>
            </variable>
          </inputVars>
          <inOutVars>
            <variable name="chain">
              <type>
                <derived name="Chain" />
              </type>
            </variable>
          </inOutVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">push_state_to_chain := FALSE;

IF state = EMPTY_STATE THEN
	RETURN;
END_IF

IF LOWER_BOUND(chain.states, 1) &gt; chain.depth OR chain.depth &gt; UPPER_BOUND(chain.states, 1) THEN
	RETURN;
END_IF

chain.states[chain.depth] := state;
chain.depth               := chain.depth + 1;
push_state_to_chain       := TRUE;
</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>6e1e82fe-9746-408e-afbc-521e5831e7b3</ObjectId>
          </data>
        </addData>
      </pou>
      <pou name="state_at_depth" pouType="function">
        <interface>
          <returnType>
            <derived name="STATE" />
          </returnType>
          <inputVars>
            <variable name="depth">
              <type>
                <derived name="DEPTH" />
              </type>
            </variable>
          </inputVars>
          <inOutVars constant="true">
            <variable name="chain">
              <type>
                <derived name="Chain" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Chain in which to find the state at the given depth </xhtml>
              </documentation>
            </variable>
          </inOutVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">state_at_depth := EMPTY_STATE;

IF LOWER_BOUND(chain.states, 1) &gt; depth THEN
	RETURN;
END_IF

IF depth &gt; UPPER_BOUND(chain.states, 1) THEN
	RETURN;
END_IF

state_at_depth := chain.states[depth];
</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>57dcb1f8-0d9e-467a-bc20-b0ed53454412</ObjectId>
          </data>
        </addData>
      </pou>
      <pou name="super_state_of" pouType="function">
        <interface>
          <returnType>
            <derived name="STATE" />
          </returnType>
          <inputVars>
            <variable name="state">
              <type>
                <derived name="STATE" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Sub-state for which the super-state is to be looked up </xhtml>
              </documentation>
            </variable>
          </inputVars>
          <inputVars constant="true">
            <variable name="hierarchy">
              <type>
                <pointer>
                  <baseType>
                    <derived name="Tuple" />
                  </baseType>
                </pointer>
              </type>
              <addData>
                <data name="http://www.3s-software.com/plcopenxml/attributes" handleUnknown="implementation">
                  <Attributes>
                    <Attribute Name="variable_length_array_original_scope" Value="Inout" />
                    <Attribute Name="variable_length_array" Value="ARRAY[*] OF Tuple" />
                    <Attribute Name="Dimensions" Value="1" />
                  </Attributes>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Array of state tuples representing the infinite state hierarchy </xhtml>
              </documentation>
            </variable>
          </inputVars>
          <localVars>
            <variable name="depth">
              <type>
                <derived name="DEPTH" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Loop index for iterating through topology tuples </xhtml>
              </documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">super_state_of := EMPTY_STATE;

FOR depth := LOWER_BOUND(hierarchy, 1) TO UPPER_BOUND(hierarchy, 1) DO
	IF hierarchy[depth].subState = state THEN
		super_state_of := hierarchy[depth].superState;
		EXIT;
	END_IF
END_FOR
</xhtml>
          </ST>
        </body>
