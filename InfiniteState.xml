          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>474f5380-84df-40c8-a9f1-a755a27c5461</ObjectId>
          </data>
        </addData>
      </pou>
      <pou name="empty_chain" pouType="function">
        <interface>
          <returnType>
            <BOOL />
          </returnType>
          <inOutVars>
            <variable name="chain">
              <type>
                <derived name="Chain" />
              </type>
            </variable>
          </inOutVars>
          <localVars>
            <variable name="super_state">
              <type>
                <derived name="STATE" />
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">WHILE pop_state_from_chain(super_state, chain) DO
	;
END_WHILE;

(* Always returns TRUE, indicating the chain has been emptied, even if
   it was already empty. *)
empty_chain := TRUE;
</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
