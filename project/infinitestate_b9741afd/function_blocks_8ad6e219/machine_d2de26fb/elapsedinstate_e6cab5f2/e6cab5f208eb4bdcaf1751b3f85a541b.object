                "@Value": {
                  "TextBlobForSerialisation": "(string)ElapsedInState := EMPTY_STAMP;\nstamp          := StampInState(state);\n\nIF stamp = EMPTY_STAMP THEN\n\tRETURN;\nEND_IF\n\nElapsedInState := now - stamp;\n",
