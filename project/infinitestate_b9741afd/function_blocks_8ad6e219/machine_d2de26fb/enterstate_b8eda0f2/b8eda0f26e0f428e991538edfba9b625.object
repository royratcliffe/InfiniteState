            "@Value": {
              "TextDocument": {
                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)METHOD PROTECTED EnterState : BOOL\nVAR_INPUT\n\tdepth : DEPTH;\nEND_VAR\n",
                  "LineInfoPersistence": "(string)b8eda0f2-6e0f-428e-9915-38edfba9b625_Decl_LineIds"
                }
              }
            }
          }
