              "TextDocument": {
                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)EnterState := FALSE;\n\nIF LOWER_BOUND(stamps, 1) > depth OR depth > UPPER_BOUND(stamps, 1) THEN\n\tRETURN;\nEND_IF\n\nstamps[depth] := now;\nEnterState    := TRUE;\n",
                  "LineInfoPersistence": "(string)b8eda0f2-6e0f-428e-9915-38edfba9b625_Impl_LineIds"
                }
              }
            }
          },
          "Interface": {
