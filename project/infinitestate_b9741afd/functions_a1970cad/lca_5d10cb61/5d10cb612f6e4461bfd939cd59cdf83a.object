          "Implementation": {
            "@Type": "3b83b776",
            "@Value": {
              "TextDocument": {
                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)WHILE depth < incoming.depth DO\n\tIF depth = outgoing.depth THEN\n\t\tEXIT;\n\tEND_IF\n\n\tIF LOWER_BOUND(outgoing.states, 1) > depth OR depth > UPPER_BOUND(outgoing.states, 1) THEN\n\t\tEXIT;\n\tEND_IF\n\n\tIF outgoing.states[depth] <> incoming.states[depth] THEN\n\t\tEXIT;\n\tEND_IF\n\n\tdepth := depth + 1;\nEND_WHILE\n\nlca := depth;\n",
                  "LineInfoPersistence": "(string)5d10cb61-2f6e-4461-bfd9-39cd59cdf83a_Impl_LineIds"
                }
              }
            }
          },
          "Interface": {
            "@Type": "a9ed5b7e",
            "@Value": {
              "TextDocument": {
                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)FUNCTION lca : DEPTH\nVAR_IN_OUT CONSTANT\n\toutgoing : Chain;\n\tincoming : Chain;\nEND_VAR\nVAR\n\tdepth : DEPTH := LOWER_DEPTH;\nEND_VAR\n",
                  "LineInfoPersistence": "(string)5d10cb61-2f6e-4461-bfd9-39cd59cdf83a_Decl_LineIds"
                }
              }
            }
          },
